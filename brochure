# -----------------------------------------------------------------------------
# Step 2: Prompt that teaches the LLM *how* to choose links
# -----------------------------------------------------------------------------
# System prompts set the model's role and output format.
# We ask for JSON so the next Python step can parse the result reliably.
link_system_prompt = """
You are provided with a list of links found on a webpage.
You are able to decide which of the links would be most relevant to include in a brochure about the company,
such as links to an About page, or a Company page, or Careers/Jobs pages.
You should respond in JSON as in this example:

{
    "links": [
        {"type": "about page", "url": "https://full.url/goes/here/about"},
        {"type": "careers page", "url": "https://another.full.url/careers"}
    ]
}
"""


def get_links_user_prompt(url):
    """Build the user message: homepage URL + every link found on that page."""
    user_prompt = f"""
Here is the list of links on the website {url} -
Please decide which of these are relevant web links for a brochure about the company,
respond with the full https URL in JSON format.
Do not include Terms of Service, Privacy, email links, or any links that are not relevant to the company.

Links (some might be relative links):

"""
    # Scraper returns absolute URLs when possible; join them into one prompt block.
    links = fetch_website_links(url)
    user_prompt += "\n".join(links)
    return user_prompt


# Try while learning:
# print(get_links_user_prompt("https://packers.com"))


def select_relevant_links(url):
    """
    Step 3: Call the LLM to filter homepage links down to brochure-worthy ones.

    Returns a Python dict shaped like:
      {"links": [{"type": "...", "url": "..."}, ...]}
    """
    response = openai.chat.completions.create(
        model=MODEL,
        messages=[
            # system = instructions / rules
            {"role": "system", "content": link_system_prompt},
            # user = the actual data for this run
            {"role": "user", "content": get_links_user_prompt(url)},
        ],
        # Forces a JSON object so json.loads() below is safe to use.
        response_format={"type": "json_object"},
    )
    # The model reply is text; parse it into a Python dict.
    result = response.choices[0].message.content
    links = json.loads(result)
    return links


# Try while learning:
# print(select_relevant_links("https://packers.com"))


def fetch_page_and_all_relevant_links(url):
    """
    Step 4: Gather the raw text the brochure will be based on.

    Flow:
      1. Fetch landing-page text
      2. Ask the LLM which related links matter
      3. Fetch each of those pages
      4. Combine everything into one markdown-ish string
    """
    contents = fetch_website_contents(url)
    relevant_links = select_relevant_links(url)

    result = f"## Landing Page:\n\n{contents}\n## Relevant Links:\n"
    for link in relevant_links["links"]:
        # Each item looks like: {"type": "about page", "url": "https://..."}
        result += f"\n\n### Link: {link['type']}\n"
        # Some URLs may 403/404; Scraper skips those and returns a short notice.
        result += fetch_website_contents(link["url"])
    return result


