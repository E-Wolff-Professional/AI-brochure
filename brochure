# =============================================================================
# AI Brochure Generator
# =============================================================================
# Big picture: scrape a company website → ask the LLM which pages matter →
# scrape those pages → ask the LLM to write a short brochure from that text.
#
# Pipeline (top to bottom):
#   1. Setup API key + OpenAI client
#   2. Scrape homepage links
#   3. Ask the LLM which links are brochure-relevant (JSON)
#   4. Fetch homepage + those relevant pages
#   5. Ask the LLM to write the brochure
# =============================================================================

import os
import json
from dotenv import load_dotenv
from IPython.display import Markdown, display, update_display
from Scraper import fetch_website_links, fetch_website_contents
from openai import OpenAI

# -----------------------------------------------------------------------------
# Step 1: Load secrets and create the OpenAI client
# -----------------------------------------------------------------------------
# load_dotenv reads key=value pairs from a local .env file into environment vars.
# Keep OPENAI_API_KEY in .env — never hard-code it in this file.
load_dotenv(override=True)
api_key = os.getenv("OPENAI_API_KEY")

